PORT=8787

# Local Gemma model. Runtime inference only reads from GEMMA_MODEL_DIR.
GEMMA_MODEL_ID=google/gemma-4-E2B-it
GEMMA_MODEL_DIR=./models/gemma-4-E2B-it
GEMMA_PYTHON=python
GEMMA_MAX_NEW_TOKENS=384
GEMMA_INITIAL_MAX_NEW_TOKENS=384
GEMMA_NODE_MAX_NEW_TOKENS=320
GEMMA_REGENERATE_MAX_NEW_TOKENS=160
GEMMA_TIMEOUT_MS=600000
GEMMA_DEVICE_MAP=auto
GEMMA_DTYPE=float16
GEMMA_QUANTIZATION=auto
GEMMA_GPU_MEMORY_FRACTION=0.58
GEMMA_CPU_MAX_MEMORY=48GiB
GEMMA_PERSISTENT_WORKER=true
GEMMA_INITIAL_CONTEXT_CHARS=6000
GEMMA_NODE_CONTEXT_CHARS=2400
GEMMA_REGENERATE_CONTEXT_CHARS=1600
GEMMA_CACHE_DIR=./models/.cache/huggingface
HF_HOME=./models/.cache/huggingface
TRANSFORMERS_CACHE=./models/.cache/huggingface

# Optional, used only by `npm run download:gemma`.
# HF_TOKEN=your_huggingface_token_here
